---
layout: default
---
{%- comment -%}
  Web version of the PDF résumé. All content comes from _data/cv.yml.
{%- endcomment -%}
{% assign cv = site.data.cv %}
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=STIX+Two+Text:ital,wght@0,400;0,700;1,400;1,700&display=swap"
>

<div class="resume">
  {% if page.cv_pdf %}
    <a
      class="resume-pdf"
      {% if page.cv_pdf contains '://' %}
        href="{{ page.cv_pdf }}"
      {% else %}
        href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
      {% endif %}
      target="_blank"
      rel="noopener noreferrer"
      title="Download PDF"
    >
      <i class="fa-solid fa-file-pdf"></i> PDF
    </a>
  {% endif %}

  <header class="resume-header">
    <h1>{{ cv.name }}</h1>
    <p>{{ cv.contact | join: ' | ' }}</p>
    <p>{{ cv.address }}</p>
  </header>

  {% for section in cv.sections %}
    <section class="resume-section">
      <h2>
        <span>{{ section.title }}</span>
        {% if section.legend %}
          <small>{{ section.legend }}</small>
        {% endif %}
      </h2>

      {% case section.type %}
        {% when 'text' %}
          <p class="resume-text">{{ section.text }}</p>

        {% when 'education' %}
          {% for item in section.items %}
            <div class="resume-entry">
              <div class="resume-row">
                <strong>{{ item.institution }}</strong>
                <span>{{ item.location }}</span>
              </div>
              <div class="resume-row">
                <em>{{ item.degree }}</em>
                <em>{{ item.date }}</em>
              </div>
              {% if item.details %}
                <ul>
                  {% for detail in item.details %}
                    <li>{{ detail }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endfor %}

        {% when 'experience' %}
          {% for item in section.items %}
            <div class="resume-entry">
              <div class="resume-row">
                <span>
                  <strong>{{ item.organization }}</strong>, <strong><em>{{ item.unit }}</em></strong>
                </span>
                <em>{{ item.date }}</em>
              </div>
              {% if item.details %}
                <ul>
                  {% for detail in item.details %}
                    <li>{{ detail }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endfor %}

        {% when 'bullets' %}
          <ul class="resume-bullets">
            {% for item in section.items %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>

        {% when 'publications' %}
          {% for pub in section.items %}
            {% assign pub_url = pub.url %}
            {% unless pub_url contains '://' %}
              {% assign pub_url = pub.url | relative_url %}
            {% endunless %}
            <div class="resume-pub">
              <div>
                <strong>[{{ pub.venue }}]</strong>
                {% if pub.url %}
                  <a class="resume-pub-title" href="{{ pub_url }}">{{ pub.title }}</a>
                {% else %}
                  <span class="resume-pub-title">{{ pub.title }}</span>
                {% endif %}
                {% if pub.note %}
                  <span class="resume-pub-note">({{ pub.note }})</span>
                {% endif %}
              </div>
              <div class="resume-pub-authors">
                {{
                  pub.authors
                  | replace: '†', '<sup>†</sup>'
                  | replace: '*', '<sup>*</sup>'
                  | replace: 'Mingzhe Du', '<strong>Mingzhe Du</strong>'
                }}
              </div>
            </div>
          {% endfor %}
      {% endcase %}
    </section>
  {% endfor %}

  {% if cv.last_updated %}
    <p class="resume-updated">Last Updated: {{ cv.last_updated }}</p>
  {% endif %}
</div>
